{
  "name": "vidya-setu-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade, offline-first learning platform for rural schools in India",
  "author": "Vidya Setu Team",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm --filter ./packages/* --filter ./apps/* run build",
    "dev": "pnpm --parallel run dev",
    "dev:api": "pnpm --filter @vidya-setu/api run dev",
    "dev:hub": "pnpm --filter @vidya-setu/hub run dev",
    "dev:web": "pnpm --filter @vidya-setu/web run dev",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "seed": "pnpm --filter @vidya-setu/api run seed",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
