# Cloud API Environment Configuration
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://vidyasetu:vidyasetu_secure_pass@localhost:5432/vidyasetu?schema=public"
REDIS_URL="redis://localhost:6379"

# Security & Secrets (min 32 characters)
JWT_SECRET="vidya-setu-super-secret-access-token-key-32chars"
JWT_REFRESH_SECRET="vidya-setu-super-secret-refresh-token-key-32chars"
DEVICE_HMAC_SECRET="vidya-setu-device-hmac-integrity-secret-32chars"

# S3/MinIO Storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin_secure_key"
S3_BUCKET="vidyasetu-media"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:8080"

# Notification Provider (mock | msg91 | twilio)
NOTIFICATION_PROVIDER="mock"
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
